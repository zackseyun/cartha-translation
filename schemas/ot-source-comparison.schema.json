{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peoplesbible.com/schemas/ot-source-comparison.schema.json",
  "title": "POB Old Testament source comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checked_date", "scope", "policy", "sources", "cases"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "checked_date": { "type": "string", "format": "date" },
    "scope": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls_are_manuscript_votes", "reference_text_is_rylands_transcription",
        "automatic_text_selection", "automatic_english_change"
      ],
      "properties": {
        "controls_are_manuscript_votes": { "const": false },
        "reference_text_is_rylands_transcription": { "const": false },
        "automatic_text_selection": { "const": false },
        "automatic_english_change": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "role", "url", "license", "snapshot"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "license": { "type": "string", "minLength": 1 },
          "snapshot": { "type": "string", "minLength": 1 },
          "witness_basis": { "type": "string", "minLength": 1 },
          "manuscript_level": { "type": "boolean" },
          "warning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "reference", "baseline", "readings", "observation",
          "english_effect", "decision_status", "preferred_reading",
          "canonical_change_applied"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo_path", "sha256"],
            "properties": {
              "repo_path": { "type": "string", "pattern": "^translation/ot/" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "readings": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_ref", "language", "text", "reading_class", "relationship_group", "support_status"],
              "properties": {
                "source_ref": { "type": "string", "minLength": 1 },
                "witness_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "standard_siglum": { "type": "string", "minLength": 1 },
                "locator_url": { "type": "string", "format": "uri", "pattern": "^https://" },
                "locator": { "type": "string", "minLength": 1 },
                "language": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "reading_class": { "type": "string", "minLength": 1 },
                "relationship_group": { "type": "string", "minLength": 1 },
                "support_status": { "enum": ["supports-reading", "indeterminate-lacuna", "coverage-only"] },
                "transcription_state": { "enum": ["diplomatic-with-editorial-reconstruction"] }
              }
            }
          },
          "observation": { "type": "string", "minLength": 1 },
          "english_effect": { "type": "string", "minLength": 1 },
          "decision_status": { "const": "not-adjudicated" },
          "preferred_reading": { "type": "null" },
          "canonical_change_applied": { "const": false }
        }
      }
    }
  }
}
