{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed provisional Hebrew critical-source record (not an application receipt)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "reference", "source", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reference": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["edition", "language", "text", "note", "apparatus"],
      "properties": {
        "edition": {"const": "POB-critical"},
        "language": {"const": "Hebrew"},
        "text": {"type": "string", "minLength": 1},
        "note": {"type": "string", "minLength": 1},
        "apparatus": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["witness", "reading", "note"],
          "properties": {"witness": {"type": "string", "minLength": 1}, "reading": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1}}
        }}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "selection_status", "normalization", "base_revision", "base", "candidate", "editorial_review", "composition", "canonical_application_approved", "publication_approved"],
      "properties": {
        "version": {"const": 1},
        "selection_status": {"const": "provisional-editorially-reviewed"},
        "normalization": {"const": "NFD-remove-combining-marks-and-slash-v1"},
        "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "base": {"$ref": "#/$defs/pin"},
        "candidate": {"$ref": "#/$defs/pin"},
        "editorial_review": {"$ref": "#/$defs/pin"},
        "composition": {"$ref": "#/$defs/pin"},
        "canonical_application_approved": {"const": false},
        "publication_approved": {"const": false}
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
